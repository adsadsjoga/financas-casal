# Copie para .env.local e preencha. O .env.local NÃO vai para o git.
# Supabase -> Project Settings -> Data API / API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app — usada só no link "Abrir o app" do resumo mensal.
NEXT_PUBLIC_APP_URL=https://financas-casal-one-iota.vercel.app

# --- Resumo mensal por e-mail ---
# Sem estas três, o cron roda, não quebra, mas não envia nada — o próprio
# endpoint avisa qual está faltando.

# Supabase -> Project Settings -> API Keys -> service_role.
# Ignora TODO o RLS. NUNCA prefixar com NEXT_PUBLIC_, nunca expor ao
# navegador — só a rota /api/cron/resumo-mensal usa isto, protegida pelo
# CRON_SECRET abaixo.
SUPABASE_SERVICE_ROLE_KEY=

# resend.com -> API Keys. onboarding@resend.dev funciona pra testar sem
# verificar domínio próprio (Resend -> Domains, se quiser um remetente com
# a sua marca).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Qualquer string aleatória longa. A Vercel manda esse mesmo valor sozinha
# no header Authorization quando o cron dispara (basta cadastrar a mesma
# variável no projeto) — sem ela, a rota fica aberta pra qualquer um na
# internet disparar e-mail pra todo mundo.
CRON_SECRET=
